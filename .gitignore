# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
.dev.vars.*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# reference-dataset raw downloads and large audit CSVs (reproducible via
# data_pipeline/reference_backtest.py; see docs/REFERENCE_DATASET.md).
# backtest_report.json is small and IS the evidence, so it stays tracked.
/data_raw/
/data_processed/**/*.csv

# native module build outputs (reproducible via cmake/ctest and
# build-and-test.ps1; see edge-collector-cpp/README.md and
# bms-connector-java/README.md)
edge-collector-cpp/build/
edge-collector-cpp/build2/
bms-connector-java/build/

# Python
__pycache__/
*.pyc
data_processed/reference_2016/*.pt

# TypeScript build cache
*.tsbuildinfo

# mobile-app (Capacitor native shells; see mobile-app/README.md)
mobile-app/node_modules/
mobile-app/android/local.properties
mobile-app/android/.gradle/
mobile-app/android/app/build/
mobile-app/android/build/
mobile-app/android/capacitor-cordova-android-plugins/build/
mobile-app/ios/App/Pods/
mobile-app/ios/App/build/
mobile-app/ios/App/DerivedData/
mobile-app/ios/**/*.xcuserstate
mobile-app/ios/**/xcuserdata/
# signing material must never be committed
mobile-app/**/*.keystore
mobile-app/**/*.jks
mobile-app/**/*.p12
mobile-app/**/*.mobileprovision
